# Copy from the repository root:
# cp packages/lightclaw/config.env.example .env
# Fill credentials locally. Do not commit .env or paste it into chat.
LIGHTCLAW_TRANSPORT=feishu
LIGHTCLAW_FEISHU_APP_ID=
LIGHTCLAW_FEISHU_APP_SECRET=

# This ID exists in the checked-in pi model catalog; live access is not verified.
LIGHTCLAW_MODEL_PROVIDER=deepseek
LIGHTCLAW_MODEL_ID=deepseek-v4-flash
DEEPSEEK_API_KEY=
# For private gateways, use upstream ModelRegistry JSON and the exact model ID:
# LIGHTCLAW_MODELS_FILE=/absolute/path/to/models.json
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://your-gateway.example/v1

LIGHTCLAW_WORK_DIR=./lightclaw-data
LIGHTCLAW_CONTROL_DIR=./lightclaw-control
# host executes tools as your OS user. For Docker, create the container first:
# bash packages/lightclaw/docker.sh create ./lightclaw-data
# LIGHTCLAW_SANDBOX=docker:lightclaw-sandbox
LIGHTCLAW_SANDBOX=host

# Optional Slack connection (set LIGHTCLAW_TRANSPORT=slack):
# LIGHTCLAW_SLACK_APP_TOKEN=
# LIGHTCLAW_SLACK_BOT_TOKEN=

# Add explicit IDs for a shared chat; empty means all participants are trusted.
# LIGHTCLAW_TRUSTED_USER_IDS=
# LIGHTCLAW_CONTROL_ADMIN_USER_IDS=
# LIGHTCLAW_MODEL_FALLBACKS=provider/model
# LIGHTCLAW_FEATURE_OPTIMIZATION=false
# LIGHTCLAW_RUN_MAX_DURATION_MS=300000
# LIGHTCLAW_RUN_MAX_TOOL_CALLS=100
# LIGHTCLAW_RUN_MAX_TOKENS=100000
