[
  {
    "id": "holdout-multi-artifact",
    "prompt": "在 scratch 下写两份文件：plan.txt 含 PLAN_READY，result.txt 含 RESULT_READY。读回两份文件，确认内容后回复两份产物已核验。",
    "expect": {
      "responseIncludes": ["核验"],
      "filesExist": ["scratch/plan.txt", "scratch/result.txt"],
      "filesContain": [{ "path": "scratch/plan.txt", "text": "PLAN_READY" }, { "path": "scratch/result.txt", "text": "RESULT_READY" }],
      "maxToolErrors": 0,
      "maxDurationMs": 120000
    }
  },
  {
    "id": "holdout-revise-artifact",
    "prompt": "创建 scratch/revision.txt，先写 version-draft，再使用编辑工具替换为 version-reviewed。读回确认，回复已审阅。",
    "expect": {
      "responseIncludes": ["已审阅"],
      "filesContain": [{ "path": "scratch/revision.txt", "text": "version-reviewed" }],
      "maxToolErrors": 0,
      "maxDurationMs": 120000
    }
  }
]
