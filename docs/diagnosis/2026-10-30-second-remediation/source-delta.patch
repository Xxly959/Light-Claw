+	expect(() => next.retry(a.id)).toThrow("manual");
+	next.retry(a.id, true);
+	next.start(a.id);
+	next.finish(a.id, "dead", "injected");
+	next.retry(a.id, true);
+	next.start(a.id);
+	next.finish(a.id, "dead", "injected");
+	expect(() => next.retry(a.id, true)).toThrow("attempt");
+});
