+	const b = first.admit("slack", { ...event, ts: "2" }, false, 60_000);
+	first.start(a.id);
+	const next = new DurableInbox(dir);
+	const queued = next.recover();
+	expect(queued.map((r) => r.id)).toEqual([b.id]);
