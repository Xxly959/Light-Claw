# LightClaw 环境变量模板
#
# 用法：
#   cp .env.example .env
#   然后在 .env 里填入真实值，用 scripts/start-lightclaw.sh 启动
#
# .env 已被 .gitignore 忽略（第 13 行），不会被提交。
# 注意：.env 里留空的变量会以空值覆盖当前 shell 的同名变量，
# 所以不要把「已在 shell 里配好的变量」以空值抄进来。

# 平台：feishu 或 slack，不填默认 feishu
LIGHTCLAW_TRANSPORT=feishu

# 飞书自建应用凭证：开发者后台 -> 应用 -> 凭证与基础信息
LIGHTCLAW_FEISHU_APP_ID=
LIGHTCLAW_FEISHU_APP_SECRET=

# 改用 Slack 时填这两项，并把上面的 LIGHTCLAW_TRANSPORT 改成 slack
# LIGHTCLAW_SLACK_APP_TOKEN=xapp-xxx
# LIGHTCLAW_SLACK_BOT_TOKEN=xoxb-xxx

# 模型：provider 与 model ID 必须存在于 pi 的模型注册表
LIGHTCLAW_MODEL_PROVIDER=zai
LIGHTCLAW_MODEL_ID=glm-5.3-flash
# 模型 API Key。若当前 shell 里已经有 ZAI_API_KEY，就别取消下面这行的注释，
# 否则空值会把它覆盖掉。
# ZAI_API_KEY=

# 启动参数
LIGHTCLAW_WORK_DIR=./lightclaw-data
# host 或 docker:<容器名>；docker 需先 bash packages/lightclaw/docker.sh create ./lightclaw-data
LIGHTCLAW_SANDBOX=host
